generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum MembershipStatus { ACTIVE INVITED SUSPENDED DEACTIVATED }
enum RfqStatus { DRAFT PUBLISHED QUOTING CLOSED EVALUATION AWARDED CANCELLED EXPIRED }
enum QuotationStatus { DRAFT SUBMITTED UNDER_REVIEW ACCEPTED REJECTED EXPIRED WITHDRAWN }
enum PoStatus { DRAFT PENDING_APPROVAL APPROVED SENT_TO_SUPPLIER ACCEPTED AWAITING_FUNDING FUNDED IN_FULFILMENT DELIVERED COMPLETED CANCELLED DISPUTED TERMINATED }
enum PaymentStatus { CREATED PENDING CONFIRMED ALLOCATED PARTIALLY_SETTLED SETTLED FAILED EXPIRED REVERSED REFUND_PENDING REFUNDED }
enum ShipmentStatus { DRAFT READY DISPATCHED IN_TRANSIT ARRIVED DELIVERY_REVIEW COMPLETED DELAYED CANCELLED FAILED }
enum DeliveryStatus { EXPECTED ARRIVED INSPECTION ACCEPTED PARTIALLY_ACCEPTED REJECTED }
enum SettlementStatus { NOT_DUE ELIGIBLE PREPARED PENDING_APPROVAL APPROVED PROCESSING SETTLED HELD FAILED REVERSED }
enum InventoryMovementType { RECEIPT ISSUE TRANSFER_OUT TRANSFER_IN ADJUSTMENT_PLUS ADJUSTMENT_MINUS RETURN_TO_SUPPLIER }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  phone String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships OrganizationMember[]
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  legalName String
  tradingName String?
  status String @default("ACTIVE")
  country String
  createdAt DateTime @default(now())
  members OrganizationMember[]
  projects Project[]
  auditEvents AuditEvent[]
  outboxEvents OutboxEvent[]
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  name String
  permissions Json
  members OrganizationMember[]
  @@index([organizationId])
}
model OrganizationMember {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid
  status MembershipStatus @default(ACTIVE)
  projectScope Json?
  approvalLimitMinor BigInt?
  joinedAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id])
  user User @relation(fields:[userId], references:[id])
  role Role @relation(fields:[roleId], references:[id])
  @@unique([organizationId,userId])
  @@index([organizationId,status])
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  code String
  name String
  type String?
  budgetMinor BigInt
  currency String @db.VarChar(3)
  status String @default("ACTIVE")
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id])
  sites ProjectSite[]
  rfqs Rfq[]
  purchaseOrders PurchaseOrder[]
  @@unique([organizationId,code])
  @@index([organizationId,status,updatedAt])
}
model ProjectSite {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name String
  address String
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  active Boolean @default(true)
  project Project @relation(fields:[projectId], references:[id])
  inventoryItems InventoryItem[]
}
model Rfq {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String @db.Uuid
  reference String
  deadline DateTime?
  status RfqStatus @default(DRAFT)
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId], references:[id])
  quotations Quotation[]
  @@unique([organizationId,reference])
  @@index([organizationId,status,updatedAt])
  @@index([projectId,status])
}
model Quotation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  rfqId String @db.Uuid
  supplierId String @db.Uuid
  status QuotationStatus @default(DRAFT)
  subtotalMinor BigInt
  taxMinor BigInt @default(0)
  deliveryMinor BigInt @default(0)
  otherFeesMinor BigInt @default(0)
  currency String @db.VarChar(3)
  submittedAt DateTime?
  rfq Rfq @relation(fields:[rfqId], references:[id])
  @@index([rfqId,status])
  @@index([supplierId,status])
}
model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String @db.Uuid
  supplierId String @db.Uuid
  reference String
  awardSnapshot Json
  totalMinor BigInt
  currency String @db.VarChar(3)
  status PoStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId], references:[id])
  paymentRequests PaymentRequest[]
  shipments Shipment[]
  settlements Settlement[]
  @@unique([organizationId,reference])
  @@index([organizationId,status,updatedAt])
}
model PaymentRequest {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  purchaseOrderId String @db.Uuid
  provider String
  providerReference String?
  amountMinor BigInt
  currency String @db.VarChar(3)
  status PaymentStatus @default(CREATED)
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id])
  @@unique([organizationId,idempotencyKey])
  @@index([providerReference])
}
model ProviderEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  providerEventId String
  rawPayload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider,providerEventId])
}
model LedgerJournal {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  reference String @unique
  currency String @db.VarChar(3)
  createdAt DateTime @default(now())
  entries LedgerEntry[]
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  journalId String @db.Uuid
  account String
  debitMinor BigInt @default(0)
  creditMinor BigInt @default(0)
  journal LedgerJournal @relation(fields:[journalId], references:[id])
  @@index([journalId])
}
model Shipment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  purchaseOrderId String @db.Uuid
  trackingRef String
  status ShipmentStatus @default(DRAFT)
  vehicle String?
  driver String?
  dispatchAt DateTime?
  eta DateTime?
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id])
  delivery Delivery?
  @@index([organizationId,status])
}
model Delivery {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  shipmentId String @unique @db.Uuid
  projectSiteId String @db.Uuid
  status DeliveryStatus @default(EXPECTED)
  arrivedAt DateTime?
  acceptedBy String? @db.Uuid
  shipment Shipment @relation(fields:[shipmentId], references:[id])
  items DeliveryItem[]
  @@index([organizationId,status])
}
model DeliveryItem {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  materialId String
  unit String
  expectedQty Decimal @db.Decimal(18,4)
  receivedQty Decimal @default(0) @db.Decimal(18,4)
  acceptedQty Decimal @default(0) @db.Decimal(18,4)
  rejectedQty Decimal @default(0) @db.Decimal(18,4)
  rejectionReason String?
  delivery Delivery @relation(fields:[deliveryId], references:[id])
}
model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectSiteId String @db.Uuid
  materialId String
  unit String
  balance Decimal @default(0) @db.Decimal(18,4)
  site ProjectSite @relation(fields:[projectSiteId], references:[id])
  movements InventoryMovement[]
  @@unique([projectSiteId,materialId,unit])
}
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  inventoryItemId String @db.Uuid
  type InventoryMovementType
  quantity Decimal @db.Decimal(18,4)
  sourceEntityType String
  sourceEntityId String @db.Uuid
  actorId String? @db.Uuid
  requestId String @db.Uuid
  occurredAt DateTime @default(now())
  item InventoryItem @relation(fields:[inventoryItemId], references:[id])
  @@index([inventoryItemId,occurredAt])
}
model Settlement {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  purchaseOrderId String @db.Uuid
  supplierId String @db.Uuid
  eligibleMinor BigInt
  feeMinor BigInt @default(0)
  withholdingMinor BigInt @default(0)
  netMinor BigInt
  currency String @db.VarChar(3)
  status SettlementStatus @default(NOT_DUE)
  preparedBy String? @db.Uuid
  approvedBy String? @db.Uuid
  providerPayoutRef String?
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id])
  @@index([organizationId,status])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorType String
  actorId String? @db.Uuid
  action String
  entityType String
  entityId String @db.Uuid
  requestId String @db.Uuid
  source String
  beforeJson Json?
  afterJson Json?
  metadataJson Json
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id])
  @@index([organizationId,createdAt])
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  eventType String
  aggregateType String
  aggregateId String @db.Uuid
  payloadJson Json
  occurredAt DateTime @default(now())
  publishedAt DateTime?
  attempts Int @default(0)
  lastError String?
  organization Organization @relation(fields:[organizationId], references:[id])
  @@index([publishedAt,occurredAt])
}
model AiRun {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId String @db.Uuid
  purpose String
  provider String
  model String
  status String
  inputJson Json
  outputJson Json?
  confidence Decimal? @db.Decimal(5,4)
  createdAt DateTime @default(now())
  completedAt DateTime?
  proposedActions AiProposedAction[]
}
model AiProposedAction {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  actionType String
  riskClass String
  payloadJson Json
  policyDecision String
  status String @default("PENDING_REVIEW")
  run AiRun @relation(fields:[runId], references:[id])
}
