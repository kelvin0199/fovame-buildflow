{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../.. && npm install && npm run db:generate && npm run build -w @buildflow/api"
  },
  "deploy": {
    "startCommand": "cd ../.. && npm run start:prod -w @buildflow/api",
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
